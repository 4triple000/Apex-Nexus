# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/apex
# Signs login tokens. Required when NODE_ENV=production. Use a long random value.
SESSION_SECRET=
# OpenAI — either the Replit AI integration pair, or a plain API key
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
# Only set to true if the API server runs in an isolated container with no secrets
ALLOW_SERVER_PYTHON=false
# Comma-separated emails of owner accounts (unlocks the Dev Cockpit and code-apply tools)
OWNER_EMAILS=
# Optional: enables BullMQ job queue and shared caching
REDIS_URL=

# ── Web app (Vite) ────────────────────────────────────────────────────────────
# BASE_PATH=/  (also needs PORT when running the web dev server)

# ── Stripe billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
STRIPE_PRICE_FREE_MONTHLY=
STRIPE_PRICE_FREE_YEARLY=

# ── Optional integrations ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ELEVENLABS_API_KEY=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
RENDER_API_KEY=
RENDER_SERVICE_ID=
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
